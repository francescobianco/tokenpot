# development | production
POOL_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:3000/v1
POOL_NAME=Community LLM Pool
DATABASE_PATH=./data/pool.sqlite

# openssl rand -hex 32
SESSION_SECRET=

# GitHub OAuth app (callback: $PUBLIC_URL/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Membership: github_sponsors | allowlist | open
MEMBERSHIP_VERIFICATION=github_sponsors
GITHUB_SPONSORABLE_LOGIN=
GITHUB_SPONSORABLE_TYPE=user
# Token of the sponsorable account, used to list sponsors (including private ones)
GITHUB_SPONSORS_TOKEN=
# Secret of the "sponsorship" webhook (endpoint: $PUBLIC_URL/webhooks/github)
GITHUB_WEBHOOK_SECRET=

# Upstream providers
OPENROUTER_API_KEY=

# Local development helpers (ignored in production)
MOCK_PROVIDER_ENABLED=false
DEV_LOGIN=false
